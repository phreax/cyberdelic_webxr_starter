<!--
  Floating Toolbar (PRD 5.3): icon buttons. Element ids used by playground-experience.ts.
-->
<style>
  .toolbar {
    flex-direction: row;
    gap: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 30px;
    border-width: 2px;
    border-color: #00d9c740;
    background-color: #152322d9;
  }
  .tool {
    width: 56px;
    height: 56px;
    align-items: center;
    justify-content: center;
    border-radius: 28px;
    border-width: 2px;
    border-color: #00d9c7;
    color: #f1f7f5;
  }
  .icon {
    width: 28px;
    height: 28px;
  }
</style>
<div id="toolbar" class="toolbar">
  <div id="tb-reset" class="tool"><RotateCcw class="icon"></RotateCcw></div>
  <div id="tb-sound" class="tool"><Volume2 class="icon"></Volume2></div>
  <div id="tb-place" class="tool"><MapPin class="icon"></MapPin></div>
  <div id="tb-menu" class="tool"><PanelTop class="icon"></PanelTop></div>
</div>
