<style>
  .panel {
    flex-direction: column;
    width: 420px;
    gap: 18px;
    padding-top: 26px;
    padding-bottom: 26px;
    padding-left: 26px;
    padding-right: 26px;
    border-radius: 22px;
    border-width: 2px;
    border-color: #00d9c740;
    background-color: #152322d9;
  }
  .eyebrow {
    color: #ff9500;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
  }
  .title {
    color: #f1f7f5;
    font-size: 30px;
    font-weight: 700;
  }
  .muted {
    color: #9baeab;
    font-size: 16px;
  }
  .label {
    color: #f1f7f5;
    font-size: 18px;
  }
  .value {
    color: #00d9c7;
    font-size: 18px;
    font-weight: 700;
  }
  .tabs {
    flex-direction: row;
    gap: 8px;
  }
  .tab {
    flex-grow: 1;
    justify-content: center;
    text-align: center;
    padding-top: 12px;
    padding-bottom: 12px;
    border-radius: 12px;
    border-width: 2px;
    border-color: #00d9c7;
    color: #f1f7f5;
    font-size: 18px;
    font-weight: 700;
  }
  .page {
    flex-direction: column;
    gap: 20px;
  }
  .row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .column {
    flex-direction: column;
    gap: 10px;
  }
  .full-width {
    width: 100%;
  }
  .track {
    height: 30px;
    border-radius: 15px;
    border-width: 2px;
    border-color: #00d9c7;
    background-color: #071514;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    padding-right: 5px;
  }
  .fill {
    height: 100%;
    border-radius: 10px;
    background-color: #00d9c7;
  }
  .knob {
    width: 84px;
    height: 84px;
    border-radius: 42px;
    border-width: 2px;
    border-color: #00d9c7;
    background-color: #071514;
  }
  .knob-value {
    width: 64px;
    color: #00d9c7;
    font-size: 18px;
    font-weight: 700;
  }
  .knob-indicator {
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    padding-top: 8px;
  }
  .knob-dot {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: #ff9500;
  }
  .toggle {
    flex-direction: row;
    align-items: center;
    width: 72px;
    height: 38px;
    border-radius: 19px;
    border-width: 2px;
    border-color: #00d9c7;
    padding-left: 5px;
    padding-right: 5px;
  }
  .toggle-thumb {
    width: 26px;
    height: 26px;
    border-radius: 13px;
    background-color: #9baeab;
  }
  .icon-button {
    align-self: flex-start;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 12px;
    border-width: 2px;
    border-color: #00d9c7;
    color: #9baeab;
    font-size: 15px;
    font-weight: 700;
  }
  .button {
    flex-grow: 1;
    justify-content: center;
    text-align: center;
    padding-top: 14px;
    padding-bottom: 14px;
    border-radius: 14px;
    border-width: 2px;
    border-color: #00d9c7;
    color: #f1f7f5;
    font-size: 18px;
    font-weight: 700;
  }
  .grid {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 10px;
  }
  .preset {
    width: 179px;
    flex-direction: column;
    gap: 4px;
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 14px;
    border-width: 2px;
    border-color: #00d9c7;
  }
  .preset-name {
    color: #f1f7f5;
    font-size: 19px;
    font-weight: 700;
  }
  .meter-row {
    flex-direction: row;
    align-items: center;
    gap: 12px;
  }
  .meter-label {
    width: 56px;
    color: #9baeab;
    font-size: 15px;
  }
  .meter {
    flex-grow: 1;
    height: 12px;
    border-radius: 6px;
    background-color: #071514;
  }
  .meter-fill {
    height: 100%;
    width: 0%;
    border-radius: 6px;
    background-color: #00d9c7;
  }
  .spectrum {
    flex-direction: row;
    align-items: flex-end;
    gap: 4px;
    height: 60px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 10px;
    background-color: #071514;
  }
  .spectrum-bar {
    flex-grow: 1;
    height: 2px;
    border-radius: 2px;
    background-color: #ff9500;
  }
  .status {
    flex-direction: row;
    align-items: center;
    gap: 10px;
  }
  .status-dot {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: #9baeab;
  }
  .small-button {
    flex-grow: 1;
    justify-content: center;
    text-align: center;
    padding-top: 12px;
    padding-bottom: 12px;
    border-radius: 12px;
    border-width: 2px;
    border-color: #00d9c7;
    color: #f1f7f5;
    font-size: 16px;
    font-weight: 700;
  }
  .demos {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }
  .demos-label {
    color: #9baeab;
    font-size: 13px;
    margin-right: 4px;
  }
  .demo-chip {
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 10px;
    border-width: 2px;
    border-color: #00d9c7;
    color: #f1f7f5;
    font-size: 13px;
    font-weight: 700;
  }
  .glow-choice { flex-direction: row; align-items: center; gap: 8px; }
  .glow-swatch { width: 16px; height: 16px; border-radius: 8px; }
  .glow-original { background-color: #794de6; }
  .glow-magenta { background-color: #ff4ccf; }
  .glow-cyan { background-color: #00d9c7; }
  .glow-amber { background-color: #ff9500; }
  .glow-white { background-color: #ffffff; }

  .primary { border-color: #ff9500; background-color: #ff9500; color: #071514; }
  .console-nav { width: 48px; height: 48px; align-items: center; justify-content: center; border-radius: 11px; border-width: 2px; border-color: #00d9c7; color: #f1f7f5; }
  .console-page { flex-direction: column; gap: 12px; }
  .console-grid { flex-direction: row; flex-wrap: wrap; gap: 8px; }
  .console-choice { width: 160px; padding-top: 10px; padding-bottom: 10px; padding-left: 10px; padding-right: 10px; border-width: 2px; border-color: #00d9c7; border-radius: 10px; color: #f1f7f5; font-size: 16px; }
</style>

<!--
  Meta Chrome panel. 1px = 1 mm at node scale 0.1.
  Element ids are the contract used by src/examples/meta-chrome/meta-chrome-experience.ts.
-->
<div id="panel" class="panel">
  <div class="row">
    <div class="column">
      <span class="eyebrow">CYBERDELIC XR</span>
      <span class="title">Meta Chrome</span>

    </div>
    <div class="row"><div id="btn-hide" class="console-nav"><X /></div></div>
  </div>
  <div id="console-object" class="console-page">


  <div class="tabs">
    <div id="tab-shape" class="tab">Shape</div>
    <div id="tab-glow" class="tab">Glow</div>
    <div id="tab-light" class="tab">Light</div>

  </div>

  <div id="page-shape" class="page">
    <span id="interaction-hint" class="muted">Transform/Move: both hands zoom and rotate; right hand moves the object.</span>
    <div class="row"><span class="label">Manipulate mode</span><div id="manipulateMode" class="toggle"><div id="manipulateMode-thumb" class="toggle-thumb"></div></div></div>
    <div id="manipulate-controls" class="column full-width">
      <div class="column full-width"><div class="row"><span class="label">Sphere size</span><span id="sphereSize-value" class="value">0.20</span></div><div id="sphereSize" class="track full-width"><div id="sphereSize-fill" class="fill"></div></div></div>
      <div class="column full-width"><div class="row"><span class="label">Smin blend</span><span id="sminFactor-value" class="value">0.30</span></div><div id="sminFactor" class="track full-width"><div id="sminFactor-fill" class="fill"></div></div></div>
      <div class="row"><span class="label">Show spheres</span><div id="showSpheres" class="toggle"><div id="showSpheres-thumb" class="toggle-thumb"></div></div></div>
    </div>
    <div class="column">
      <div class="row">
        <span class="label">Speed</span>
        <span id="speed-value" class="value">0.50</span>
      </div>
      <div id="speed" class="track">
        <div id="speed-fill" class="fill"></div>
      </div>
    </div>
  </div>

  <div id="page-glow" class="page">
    <div class="column">
      <div class="row">
        <span class="label">Glow amount</span>
        <span id="glowAmount-value" class="value">1.00</span>
      </div>
      <div id="glowAmount" class="track">
        <div id="glowAmount-fill" class="fill"></div>
      </div>
    </div>
    <span class="label">Glow color</span>
    <div class="demos">
      <div id="glowColor-original" class="demo-chip glow-choice"><div class="glow-swatch glow-original"></div><span>Original</span></div>
      <div id="glowColor-magenta" class="demo-chip glow-choice"><div class="glow-swatch glow-magenta"></div><span>Magenta</span></div>
      <div id="glowColor-cyan" class="demo-chip glow-choice"><div class="glow-swatch glow-cyan"></div><span>Cyan</span></div>
      <div id="glowColor-amber" class="demo-chip glow-choice"><div class="glow-swatch glow-amber"></div><span>Amber</span></div>
      <div id="glowColor-white" class="demo-chip glow-choice"><div class="glow-swatch glow-white"></div><span>White</span></div>
    </div>
  </div>

  <div id="page-light" class="page">
    <div class="column"><div class="row"><span class="label">Exposure</span><span id="exposure-value" class="value">1.00</span></div><div id="exposure" class="track"><div id="exposure-fill" class="fill"></div></div></div>
    <div class="column"><div class="row"><span class="label">Reflection warmth</span><span id="reflectionWarmth-value" class="value">0.50</span></div><div id="reflectionWarmth" class="track"><div id="reflectionWarmth-fill" class="fill"></div></div></div>
    <div class="column"><div class="row"><span class="label">Iridescent</span><span id="iridescent-value" class="value">0.50</span></div><div id="iridescent" class="track"><div id="iridescent-fill" class="fill"></div></div></div>
  </div>


  <div class="row"><span class="label">Render quality</span><div id="quality-low" class="small-button">Low</div><div id="quality-medium" class="small-button">Medium</div><div id="quality-high" class="small-button">High</div></div>
</div>
</div>
