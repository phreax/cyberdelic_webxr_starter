<style>
  .panel {
    flex-direction: column;
    width: 420px;
    gap: 6px;
    padding-top: 18px;
    padding-bottom: 18px;
    padding-left: 26px;
    padding-right: 26px;
    border-radius: 22px;
    border-width: 2px;
    border-color: #00d9c740;
    background-color: #152322d9;
  }
  .eyebrow {
    color: #ff9500;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
  }
  .title {
    color: #f1f7f5;
    font-size: 30px;
    font-weight: 700;
  }
  .muted {
    color: #9baeab;
    font-size: 16px;
  }
  .label {
    color: #f1f7f5;
    font-size: 18px;
  }
  .value {
    color: #00d9c7;
    font-size: 18px;
    font-weight: 700;
  }
  .tabs {
    flex-direction: row;
    gap: 8px;
  }
  .tab {
    flex-grow: 1;
    justify-content: center;
    text-align: center;
    padding-top: 12px;
    padding-bottom: 12px;
    border-radius: 12px;
    border-width: 2px;
    border-color: #00d9c7;
    color: #f1f7f5;
    font-size: 18px;
    font-weight: 700;
  }
  .page {
    flex-direction: column;
    gap: 9px;
  }
  .row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .column {
    flex-direction: column;
    gap: 10px;
  }
  .track {
    height: 30px;
    border-radius: 15px;
    border-width: 2px;
    border-color: #00d9c7;
    background-color: #071514;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    padding-right: 5px;
  }
  .fill {
    height: 100%;
    border-radius: 10px;
    background-color: #00d9c7;
  }
  .knob {
    width: 84px;
    height: 84px;
    border-radius: 42px;
    border-width: 2px;
    border-color: #00d9c7;
    background-color: #071514;
  }
  .knob-value {
    width: 64px;
    color: #00d9c7;
    font-size: 18px;
    font-weight: 700;
  }
  .knob-indicator {
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    padding-top: 8px;
  }
  .knob-dot {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: #ff9500;
  }
  .toggle {
    flex-direction: row;
    align-items: center;
    width: 72px;
    height: 38px;
    border-radius: 19px;
    border-width: 2px;
    border-color: #00d9c7;
    padding-left: 5px;
    padding-right: 5px;
  }
  .toggle-thumb {
    width: 26px;
    height: 26px;
    border-radius: 13px;
    background-color: #9baeab;
  }
  .icon-button {
    align-self: flex-start;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 12px;
    border-width: 2px;
    border-color: #00d9c7;
    color: #9baeab;
    font-size: 15px;
    font-weight: 700;
  }
  .button {
    flex-grow: 1;
    justify-content: center;
    text-align: center;
    padding-top: 14px;
    padding-bottom: 14px;
    border-radius: 14px;
    border-width: 2px;
    border-color: #00d9c7;
    color: #f1f7f5;
    font-size: 18px;
    font-weight: 700;
  }
  .grid {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 10px;
  }
  .preset {
    width: 179px;
    flex-direction: column;
    gap: 4px;
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 14px;
    border-width: 2px;
    border-color: #00d9c7;
  }
  .preset-name {
    color: #f1f7f5;
    font-size: 19px;
    font-weight: 700;
  }
  .meter-row {
    flex-direction: row;
    align-items: center;
    gap: 12px;
  }
  .meter-label {
    width: 56px;
    color: #9baeab;
    font-size: 15px;
  }
  .meter {
    flex-grow: 1;
    height: 12px;
    border-radius: 6px;
    background-color: #071514;
  }
  .meter-fill {
    height: 100%;
    width: 0%;
    border-radius: 6px;
    background-color: #00d9c7;
  }
  .spectrum {
    flex-direction: row;
    align-items: flex-end;
    gap: 4px;
    height: 60px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 10px;
    background-color: #071514;
  }
  .spectrum-bar {
    flex-grow: 1;
    height: 2px;
    border-radius: 2px;
    background-color: #ff9500;
  }
  .status {
    flex-direction: row;
    align-items: center;
    gap: 10px;
  }
  .status-dot {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: #9baeab;
  }
  .small-button {
    flex-grow: 1;
    justify-content: center;
    text-align: center;
    padding-top: 12px;
    padding-bottom: 12px;
    border-radius: 12px;
    border-width: 2px;
    border-color: #00d9c7;
    color: #f1f7f5;
    font-size: 16px;
    font-weight: 700;
  }
  .dropdown {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 12px;
    border-width: 2px;
    border-color: #00d9c7;
    color: #f1f7f5;
    font-size: 17px;
  }
  .dropdown-list {
    flex-direction: column;
    gap: 6px;
  }
  .option {
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 10px;
    border-width: 2px;
    border-color: #00d9c7;
    color: #f1f7f5;
    font-size: 16px;
  }
  .swatch {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    border-width: 3px;
    border-color: #00d9c7;
  }
  .preview {
    width: 64px;
    height: 40px;
    border-radius: 10px;
  }
  .readout {
    color: #ff9500;
    font-size: 34px;
    font-weight: 700;
  }
  .log {
    color: #dbe7e5;
    font-size: 15px;
  }
  .demos {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }
  .demos-label {
    color: #9baeab;
    font-size: 13px;
    margin-right: 4px;
  }
  .demo-chip {
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 10px;
    border-width: 2px;
    border-color: #00d9c7;
    color: #f1f7f5;
    font-size: 13px;
    font-weight: 700;
  }
  .list-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 12px;
    border-width: 2px;
    border-color: #00d9c7;
  }
  .list-name {
    color: #f1f7f5;
    font-size: 18px;
    font-weight: 700;
  }
  .narrow {
    width: 340px;
  }

  .primary { border-color: #ff9500; background-color: #ff9500; color: #071514; }
  .console-nav { width: 48px; height: 48px; align-items: center; justify-content: center; border-radius: 11px; border-width: 2px; border-color: #00d9c7; color: #f1f7f5; }
  .console-page { flex-direction: column; gap: 12px; }
  .console-grid { flex-direction: row; flex-wrap: wrap; gap: 8px; }
  .console-choice { width: 160px; padding-top: 10px; padding-bottom: 10px; padding-left: 10px; padding-right: 10px; border-width: 2px; border-color: #00d9c7; border-radius: 10px; color: #f1f7f5; font-size: 16px; }
  .setting { min-height: 36px; }
  .setting-controls { width: 170px; }
  .setting-track { width: 100%; }
  .choice { width: 124px; }
  .color-preview { width: 48px; height: 40px; border-radius: 8px; border-width: 2px; border-color: #f1f7f5; background-color: #64f4ff; }
</style>
<div id="panel" class="panel">
<div id="scene-snake-settings" class="console-page"><div class="row"><span id="params-name" class="title">Snake Settings</span><div id="btn-close-snake-settings" class="console-nav"><X /></div></div>

  <div class="tabs">
    <div id="tab-shape" class="tab">Shape</div>
    <div id="tab-pattern" class="tab">Pattern</div>
    <div id="tab-material" class="tab">Material</div>
    <div id="tab-motion" class="tab">Motion</div>
  </div>

  <div id="page-shape" class="page">
    <div class="row"><span class="label">Mirror across YZ</span><div id="mirror" class="toggle"><div id="mirror-thumb" class="toggle-thumb"></div></div></div>
    <div id="mirror-settings" class="column"><div class="row"><span class="label">Mirror distance</span><span id="mirrorDistance-value" class="value">0.20</span></div><div id="mirrorDistance" class="track"><div id="mirrorDistance-fill" class="fill"></div></div></div>
    <div class="row">
      <div id="body-tube" class="small-button">Tube</div>
      <div id="body-spheres" class="small-button">Spheres</div>
    </div>
    <div id="sphere-settings" class="column">
      <div class="column">
        <div class="row">
          <span class="label">Sphere density</span>
          <span id="sphereDensity-value" class="value">0.50</span>
        </div>
        <div id="sphereDensity" class="track">
          <div id="sphereDensity-fill" class="fill"></div>
        </div>
      </div>
      <div class="column">
        <div class="row">
          <span class="label">Sphere size</span>
          <span id="sphereSize-value" class="value">1.00</span>
        </div>
        <div id="sphereSize" class="track">
          <div id="sphereSize-fill" class="fill"></div>
        </div>
      </div>
    </div>
    <div class="column">
      <div class="row">
        <span class="label">Thickness</span>
        <span id="thickness-value" class="value">0.020</span>
      </div>
      <div id="thickness" class="track">
        <div id="thickness-fill" class="fill"></div>
      </div>
    </div>
    <div class="column">
      <div class="row">
        <span class="label">Length</span>
        <span id="length-value" class="value">0.35</span>
      </div>
      <div id="length" class="track">
        <div id="length-fill" class="fill"></div>
      </div>
    </div>
    <div class="column">
      <div class="row">
        <span class="label">Head taper</span>
        <span id="headTaper-value" class="value">0.10</span>
      </div>
      <div id="headTaper" class="track">
        <div id="headTaper-fill" class="fill"></div>
      </div>
    </div>
    <div class="column">
      <div class="row">
        <span class="label">Tail taper</span>
        <span id="tailTaper-value" class="value">0.50</span>
      </div>
      <div id="tailTaper" class="track">
        <div id="tailTaper-fill" class="fill"></div>
      </div>
    </div>
    <div class="column">
      <div class="row">
        <span class="label">Head shape</span>
        <span id="headShape-value" class="value">0.60</span>
      </div>
      <div id="headShape" class="track">
        <div id="headShape-fill" class="fill"></div>
      </div>
    </div>
    <div class="row">
      <div id="profile-round" class="small-button">Round</div>
      <div id="profile-square" class="small-button">Square</div>
    </div>
    <div class="column">
      <div class="row">
        <span class="label">Twist</span>
        <span id="twist-value" class="value">0.00</span>
      </div>
      <div id="twist" class="track">
        <div id="twist-fill" class="fill"></div>
      </div>
    </div>
  </div>

  <div id="page-pattern" class="page">
    <div class="row">
      <div id="pattern-solid" class="small-button">Solid</div>
      <div id="pattern-rings" class="small-button">Rings</div>
      <div id="pattern-hilbert" class="small-button">Hilbert</div>
    </div>
    <div id="hilbert-settings" class="column">
      <div class="row"><span class="label">Hilbert edge sharpness</span><span id="hilbertSharpness-value" class="value">1.00</span></div>
      <div id="hilbertSharpness" class="track"><div id="hilbertSharpness-fill" class="fill"></div></div>
    </div>
    <div class="row">
      <div id="palette-ethereal-garden" class="small-button">Ethereal Garden</div>
      <div id="palette-cyberdelic" class="small-button">Cyberdelic</div>
    </div>
    <div class="row">
      <div id="palette-ocean" class="small-button">Ocean</div>
      <div id="palette-ember" class="small-button">Ember</div>
    </div>
    <div class="row">
      <div id="palette-white" class="small-button">White</div>
      <div id="palette-scifi-machine" class="small-button">SciFi Machine</div>
    </div>
    <div class="column">
      <div class="row">
        <span class="label">Gradient spread</span>
        <span id="spread-value" class="value">0.05</span>
      </div>
      <div id="spread" class="track">
        <div id="spread-fill" class="fill"></div>
      </div>
    </div>
    <div class="column">
      <div class="row"><span class="label">Color offset</span><span id="gradientOffset-value" class="value">0.00</span></div>
      <div id="gradientOffset" class="track"><div id="gradientOffset-fill" class="fill"></div></div>
    </div>
    <div class="column">
      <div class="row">
        <span class="label">Pattern scale</span>
        <span id="scale-value" class="value">1.00</span>
      </div>
      <div id="scale" class="track">
        <div id="scale-fill" class="fill"></div>
      </div>
    </div>
    <div class="column">
      <div class="row">
        <span class="label">Pattern width</span>
        <span id="width-value" class="value">0.50</span>
      </div>
      <div id="width" class="track">
        <div id="width-fill" class="fill"></div>
      </div>
    </div>
    <div class="row">
      <span class="label">Transparent gaps</span>
      <div id="transparent" class="toggle">
        <div id="transparent-thumb" class="toggle-thumb"></div>
      </div>
    </div>
    <div id="bg-settings" class="column">
    <div class="column">
      <div class="row">
        <span class="label">Background hue offset</span>
        <span id="backgroundOffset-value" class="value">0.50</span>
      </div>
      <div id="backgroundOffset" class="track">
        <div id="backgroundOffset-fill" class="fill"></div>
      </div>
    </div>
    <div class="column">
      <div class="row">
        <span class="label">Background brightness</span>
        <span id="backgroundBrightness-value" class="value">0.00</span>
      </div>
      <div id="backgroundBrightness" class="track">
        <div id="backgroundBrightness-fill" class="fill"></div>
      </div>
    </div>
    </div>
  </div>

  <div id="page-material" class="page">
    <div class="column">
      <div class="row">
        <span class="label">Iridescence</span>
        <span id="iridescence-value" class="value">0.10</span>
      </div>
      <div id="iridescence" class="track">
        <div id="iridescence-fill" class="fill"></div>
      </div>
    </div>
    <div class="column">
      <div class="row">
        <span class="label">Metallic</span>
        <span id="metallic-value" class="value">0.20</span>
      </div>
      <div id="metallic" class="track">
        <div id="metallic-fill" class="fill"></div>
      </div>
    </div>
    <div class="column">
      <div class="row">
        <span class="label">Environment reflection</span>
        <span id="environmentAmount-value" class="value">0.20</span>
      </div>
      <div id="environmentAmount" class="track">
        <div id="environmentAmount-fill" class="fill"></div>
      </div>
    </div>
    <div class="column">
      <div class="row">
        <span class="label">Roughness</span>
        <span id="roughness-value" class="value">0.35</span>
      </div>
      <div id="roughness" class="track">
        <div id="roughness-fill" class="fill"></div>
      </div>
    </div>
  </div>

  <div id="page-motion" class="page">
    <div class="column">
      <div class="row">
        <span class="label">Speed</span>
        <span id="speed-value" class="value">0.15</span>
      </div>
      <div id="speed" class="track">
        <div id="speed-fill" class="fill"></div>
      </div>
    </div>
    <div class="row">
      <span class="label">Reverse</span>
      <div id="reverse" class="toggle">
        <div id="reverse-thumb" class="toggle-thumb"></div>
      </div>
    </div>
  </div>
</div>
<div id="scene-center-settings" class="console-page"><div class="row"><span class="title">Center Object</span><div id="btn-close-center" class="console-nav"><X /></div></div>

  <span id="center-status" class="muted">Choose one Center Object</span>
  <div id="btn-change-center" class="button primary">Choose Object</div>
  <div id="center-choices" class="grid">
    <div id="choose-sculpture" class="button choice">Sculpture</div>
    <div id="choose-cubes" class="button choice">Cubes</div>
    <div id="choose-chrome" class="button choice">Meta Chrome</div>
  </div>
  <div class="row"><div id="btn-visibility-center" class="button">Hide</div><div id="btn-remove-center" class="button">Remove</div></div>
  <div class="tabs"><div id="tab-form" class="tab">Form</div><div id="tab-color" class="tab">Color</div><div id="center-tab-motion" class="tab">Motion</div></div>
  <div id="page-form" class="page">
    <div id="setting-sculpture-growth" class="setting row"><span class="label">Growth</span><div class="column setting-controls"><span id="center-sculpture-growth-value" class="value">0.00</span><div id="center-sculpture-growth" class="track setting-track"><div id="center-sculpture-growth-fill" class="fill"></div></div></div></div>
    <div id="setting-sculpture-complexity" class="setting row"><span class="label">Complexity</span><div class="column setting-controls"><span id="center-sculpture-complexity-value" class="value">0.00</span><div id="center-sculpture-complexity" class="track setting-track"><div id="center-sculpture-complexity-fill" class="fill"></div></div></div></div>
    <div id="setting-sculpture-quality" class="setting column"><span class="label">Mesh quality</span><div class="row"><div id="center-sculpture-quality-low" class="small-button">Low</div><div id="center-sculpture-quality-medium" class="small-button">Medium</div><div id="center-sculpture-quality-high" class="small-button">High</div></div></div>
    <div id="setting-cubes-kaleidoscope" class="setting row"><span class="label">Kaleidoscope</span><div id="center-cubes-kaleidoscope" class="toggle"><div id="center-cubes-kaleidoscope-thumb" class="toggle-thumb"></div></div></div>
    <div id="setting-cubes-mode" class="setting row"><span class="label">Mode</span><div class="column setting-controls"><span id="center-cubes-mode-value" class="value">0.00</span><div id="center-cubes-mode" class="track setting-track"><div id="center-cubes-mode-fill" class="fill"></div></div></div></div>
    <div id="setting-cubes-quality" class="setting column"><span class="label">Quality</span><div class="row"><div id="center-cubes-quality-low" class="small-button">Low</div><div id="center-cubes-quality-medium" class="small-button">Medium</div><div id="center-cubes-quality-high" class="small-button">High</div></div></div>
    <div id="setting-chrome-sphereSize" class="setting row"><span class="label">Sphere size</span><div class="column setting-controls"><span id="center-chrome-sphereSize-value" class="value">0.00</span><div id="center-chrome-sphereSize" class="track setting-track"><div id="center-chrome-sphereSize-fill" class="fill"></div></div></div></div>
    <div id="setting-chrome-showSpheres" class="setting row"><span class="label">Show spheres</span><div id="center-chrome-showSpheres" class="toggle"><div id="center-chrome-showSpheres-thumb" class="toggle-thumb"></div></div></div>
    <div id="setting-chrome-sminFactor" class="setting row"><span class="label">Smin blend</span><div class="column setting-controls"><span id="center-chrome-sminFactor-value" class="value">0.00</span><div id="center-chrome-sminFactor" class="track setting-track"><div id="center-chrome-sminFactor-fill" class="fill"></div></div></div></div>
    <div id="setting-chrome-quality" class="setting column"><span class="label">Quality</span><div class="row"><div id="center-chrome-quality-low" class="small-button">Low</div><div id="center-chrome-quality-medium" class="small-button">Medium</div><div id="center-chrome-quality-high" class="small-button">High</div></div></div>
  </div>
  <div id="page-color" class="page">
    <div id="setting-sculpture-glow" class="setting row"><span class="label">Glow</span><div class="column setting-controls"><span id="center-sculpture-glow-value" class="value">0.00</span><div id="center-sculpture-glow" class="track setting-track"><div id="center-sculpture-glow-fill" class="fill"></div></div></div></div>
    <div id="setting-sculpture-alpha" class="setting row"><span class="label">Alpha</span><div class="column setting-controls"><span id="center-sculpture-alpha-value" class="value">0.00</span><div id="center-sculpture-alpha" class="track setting-track"><div id="center-sculpture-alpha-fill" class="fill"></div></div></div></div>
    <div id="setting-sculpture-finish" class="setting row"><span class="label">Material</span><div class="column setting-controls"><span id="center-sculpture-finish-value" class="value">0.00</span><div id="center-sculpture-finish" class="track setting-track"><div id="center-sculpture-finish-fill" class="fill"></div></div></div></div>
    <div id="setting-sculpture-matcapBrightness" class="setting row"><span class="label">MatCap brightness</span><div class="column setting-controls"><span id="center-sculpture-matcapBrightness-value" class="value">0.00</span><div id="center-sculpture-matcapBrightness" class="track setting-track"><div id="center-sculpture-matcapBrightness-fill" class="fill"></div></div></div></div>
    <div id="setting-sculpture-iridescence" class="setting row"><span class="label">Iridescence</span><div class="column setting-controls"><span id="center-sculpture-iridescence-value" class="value">0.00</span><div id="center-sculpture-iridescence" class="track setting-track"><div id="center-sculpture-iridescence-fill" class="fill"></div></div></div></div>
