<style>
  .panel {
    flex-direction: column;
    width: 420px;
    gap: 18px;
    padding-top: 26px;
    padding-bottom: 26px;
    padding-left: 26px;
    padding-right: 26px;
    border-radius: 22px;
    border-width: 2px;
    border-color: #00d9c740;
    background-color: #152322d9;
  }
  .eyebrow {
    color: #ff9500;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
  }
  .title {
    color: #f1f7f5;
    font-size: 30px;
    font-weight: 700;
  }
  .muted {
    color: #9baeab;
    font-size: 16px;
  }
  .label {
    color: #f1f7f5;
    font-size: 18px;
  }
  .value {
    color: #00d9c7;
    font-size: 18px;
    font-weight: 700;
  }
  .tabs {
    flex-direction: row;
    gap: 8px;
  }
  .tab {
    flex-grow: 1;
    justify-content: center;
    text-align: center;
    padding-top: 12px;
    padding-bottom: 12px;
    border-radius: 12px;
    border-width: 2px;
    border-color: #00d9c7;
    color: #f1f7f5;
    font-size: 18px;
    font-weight: 700;
  }
  .page {
    flex-direction: column;
    gap: 20px;
  }
  .row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .column {
    flex-direction: column;
    gap: 10px;
  }
  .track {
    height: 30px;
    border-radius: 15px;
    border-width: 2px;
    border-color: #00d9c7;
    background-color: #071514;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    padding-right: 5px;
  }
  .fill {
    height: 100%;
    border-radius: 10px;
    background-color: #00d9c7;
  }
  .knob {
    width: 84px;
    height: 84px;
    border-radius: 42px;
    border-width: 2px;
    border-color: #00d9c7;
    background-color: #071514;
  }
  .knob-value {
    width: 64px;
    color: #00d9c7;
    font-size: 18px;
    font-weight: 700;
  }
  .knob-indicator {
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    padding-top: 8px;
  }
  .knob-dot {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: #ff9500;
  }
  .toggle {
    flex-direction: row;
    align-items: center;
    width: 72px;
    height: 38px;
    border-radius: 19px;
    border-width: 2px;
    border-color: #00d9c7;
    padding-left: 5px;
    padding-right: 5px;
  }
  .toggle-thumb {
    width: 26px;
    height: 26px;
    border-radius: 13px;
    background-color: #9baeab;
  }
  .icon-button {
    align-self: flex-start;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 12px;
    border-width: 2px;
    border-color: #00d9c7;
    color: #9baeab;
    font-size: 15px;
    font-weight: 700;
  }
  .button {
    flex-grow: 1;
    justify-content: center;
    text-align: center;
    padding-top: 14px;
    padding-bottom: 14px;
    border-radius: 14px;
    border-width: 2px;
    border-color: #00d9c7;
    color: #f1f7f5;
    font-size: 18px;
    font-weight: 700;
  }
  .grid {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 10px;
  }
  .preset {
    width: 179px;
    flex-direction: column;
    gap: 4px;
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 14px;
    border-width: 2px;
    border-color: #00d9c7;
  }
  .preset-name {
    color: #f1f7f5;
    font-size: 19px;
    font-weight: 700;
  }
  .meter-row {
    flex-direction: row;
    align-items: center;
    gap: 12px;
  }
  .meter-label {
    width: 56px;
    color: #9baeab;
    font-size: 15px;
  }
  .meter {
    flex-grow: 1;
    height: 12px;
    border-radius: 6px;
    background-color: #071514;
  }
  .meter-fill {
    height: 100%;
    width: 0%;
    border-radius: 6px;
    background-color: #00d9c7;
  }
  .spectrum {
    flex-direction: row;
    align-items: flex-end;
    gap: 4px;
    height: 60px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 10px;
    background-color: #071514;
  }
  .spectrum-bar {
    flex-grow: 1;
    height: 2px;
    border-radius: 2px;
    background-color: #ff9500;
  }
  .status {
    flex-direction: row;
    align-items: center;
    gap: 10px;
  }
  .status-dot {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: #9baeab;
  }
  .small-button {
    flex-grow: 1;
    justify-content: center;
    text-align: center;
    padding-top: 12px;
    padding-bottom: 12px;
    border-radius: 12px;
    border-width: 2px;
    border-color: #00d9c7;
    color: #f1f7f5;
    font-size: 16px;
    font-weight: 700;
  }
  .demos {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }
  .demos-label {
    color: #9baeab;
    font-size: 13px;
    margin-right: 4px;
  }
  .demo-chip {
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 10px;
    border-width: 2px;
    border-color: #00d9c7;
    color: #f1f7f5;
    font-size: 13px;
    font-weight: 700;
  }

  .primary { border-color: #ff9500; background-color: #ff9500; color: #071514; }
  .console-nav { width: 48px; height: 48px; align-items: center; justify-content: center; border-radius: 11px; border-width: 2px; border-color: #00d9c7; color: #f1f7f5; }
  .console-page { flex-direction: column; gap: 12px; }
  .console-grid { flex-direction: row; flex-wrap: wrap; gap: 8px; }
  .console-choice { width: 160px; padding-top: 10px; padding-bottom: 10px; padding-left: 10px; padding-right: 10px; border-width: 2px; border-color: #00d9c7; border-radius: 10px; color: #f1f7f5; font-size: 16px; }
</style>

<!--
  Particle Garden panel. 1px = 1 mm at node scale 0.1.
  Element ids are the contract used by src/examples/particle-garden/garden-experience.ts.
-->
<div id="panel" class="panel">
  <div class="row">
    <div class="column">
      <span class="eyebrow">CYBERDELIC XR</span>
      <span class="title">Particle Garden</span>

    </div>
    <div class="row"><div id="btn-hide" class="console-nav"><X /></div></div>
  </div>
  <div id="console-object" class="console-page">



  <div class="tabs">
    <div id="tab-garden" class="tab">Garden</div>
    <div id="tab-audio" class="tab">Audio</div>

  </div>

  <div id="page-garden" class="page">
    <span class="muted">Move your hands through the particles to stir currents that linger. Pinch or pull the trigger to draw particles in. Touch a ring to change the mood.</span>
    <div class="column">
      <div class="row">
        <span class="label">Density</span>
        <span id="density-value" class="value">14000</span>
      </div>
      <div id="density" class="track">
        <div id="density-fill" class="fill"></div>
      </div>
    </div>
    <div class="column">
      <div class="row">
        <span class="label">Turbulence</span>
        <span id="turbulence-value" class="value">0.12</span>
      </div>
      <div id="turbulence" class="track">
        <div id="turbulence-fill" class="fill"></div>
      </div>
    </div>
    <div class="column">
      <div class="row">
        <span class="label">Flow speed</span>
        <span id="speed-value" class="value">1.00</span>
      </div>
      <div id="speed" class="track">
        <div id="speed-fill" class="fill"></div>
      </div>
    </div>
    <div class="column">
      <div class="row">
        <span class="label">Stir strength</span>
        <span id="stir-value" class="value">1.00</span>
      </div>
      <div id="stir" class="track">
        <div id="stir-fill" class="fill"></div>
      </div>
    </div>
    <div class="column">
      <div class="row">
        <span class="label">Field memory</span>
        <span id="memory-value" class="value">2.5 s</span>
      </div>
      <div id="memory" class="track">
        <div id="memory-fill" class="fill"></div>
      </div>
    </div>
    <div class="column">
      <div class="row">
        <span class="label">Particle size</span>
        <span id="size-value" class="value">1.00</span>
      </div>
      <div id="size" class="track">
        <div id="size-fill" class="fill"></div>
      </div>
    </div>
    <div class="row">
      <div id="mood-ember" class="small-button">Ember</div>
      <div id="mood-cyberdelic" class="small-button">Cyberdelic</div>
    </div>
    <div class="row">
      <div id="mood-ethereal-garden" class="small-button">Ethereal Garden</div>
      <div id="mood-rainbow" class="small-button">Rainbow</div>
    </div>
  </div>

  <div id="page-audio" class="page">
    <div class="status">
      <div id="audio-dot" class="status-dot"></div>
      <span id="audio-status" class="muted">No audio input</span>
    </div>
    <div class="row">
      <div id="btn-mic" class="small-button">Mic</div>
      <div id="btn-capture" class="small-button">Capture</div>
      <div id="btn-demo" class="small-button">Demo</div>
      <div id="btn-stop" class="small-button">Stop</div>
    </div>
    <div class="column">
      <div class="row">
        <span class="label">Reactivity</span>
        <span id="reactivity-value" class="value">0.70</span>
      </div>
      <div id="reactivity" class="track">
        <div id="reactivity-fill" class="fill"></div>
      </div>
    </div>
  </div>


</div>
</div>
