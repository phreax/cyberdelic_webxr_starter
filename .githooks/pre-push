#!/bin/sh
# Blocks pushes to the `public` remote that contain private lab work (see scripts/check-public.mjs).
[ "$1" = "public" ] || exit 0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  node scripts/check-public.mjs --ref "$local_sha" || exit 1
done
exit 0
